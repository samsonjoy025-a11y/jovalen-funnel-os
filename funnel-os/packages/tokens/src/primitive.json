{
  "$description": "Primitive tokens — raw, context-free values. Nothing in the product may reference this layer directly (Rule A7). Source: W3C DTCG format.",
  "color": {
    "$type": "color",
    "neutral": {
      "0":   { "$value": "#ffffff" },
      "50":  { "$value": "#f8fafc" },
      "100": { "$value": "#f1f5f9" },
      "200": { "$value": "#e2e8f0" },
      "300": { "$value": "#cbd5e1" },
      "400": { "$value": "#94a3b8" },
      "500": { "$value": "#64748b" },
      "600": { "$value": "#475569" },
      "700": { "$value": "#334155" },
      "800": { "$value": "#1e293b" },
      "900": { "$value": "#0f172a" },
      "950": { "$value": "#020617" }
    },
    "primary": {
      "50":  { "$value": "#faf5ff" },
      "100": { "$value": "#f3e8ff" },
      "200": { "$value": "#e9d5ff" },
      "300": { "$value": "#d8b4fe" },
      "400": { "$value": "#c084fc" },
      "500": { "$value": "#a855f7" },
      "600": { "$value": "#b026d3" },
      "700": { "$value": "#9310a8" },
      "800": { "$value": "#7a0f8c" },
      "900": { "$value": "#651073" },
      "950": { "$value": "#43075a" }
    },
    "success": {
      "50":  { "$value": "#ecfdf5" },
      "100": { "$value": "#d1fae5" },
      "200": { "$value": "#a7f3d0" },
      "300": { "$value": "#6ee7b7" },
      "400": { "$value": "#34d399" },
      "500": { "$value": "#10b981" },
      "600": { "$value": "#059669" },
      "700": { "$value": "#047857" },
      "800": { "$value": "#065f46" },
      "900": { "$value": "#064e3b" },
      "950": { "$value": "#022c22" }
    },
    "warning": {
      "50":  { "$value": "#fffbeb" },
      "100": { "$value": "#fef3c7" },
      "200": { "$value": "#fde68a" },
      "300": { "$value": "#fcd34d" },
      "400": { "$value": "#fbbf24" },
      "500": { "$value": "#f59e0b" },
      "600": { "$value": "#d97706" },
      "700": { "$value": "#b45309" },
      "800": { "$value": "#92400e" },
      "900": { "$value": "#78350f" },
      "950": { "$value": "#451a03" }
    },
    "danger": {
      "50":  { "$value": "#fef2f2" },
      "100": { "$value": "#fee2e2" },
      "200": { "$value": "#fecaca" },
      "300": { "$value": "#fca5a5" },
      "400": { "$value": "#f87171" },
      "500": { "$value": "#ef4444" },
      "600": { "$value": "#dc2626" },
      "700": { "$value": "#b91c1c" },
      "800": { "$value": "#991b1b" },
      "900": { "$value": "#7f1d1d" },
      "950": { "$value": "#450a0a" }
    },
    "info": {
      "50":  { "$value": "#f0f9ff" },
      "100": { "$value": "#e0f2fe" },
      "200": { "$value": "#bae6fd" },
      "300": { "$value": "#7dd3fc" },
      "400": { "$value": "#38bdf8" },
      "500": { "$value": "#0ea5e9" },
      "600": { "$value": "#0284c7" },
      "700": { "$value": "#0369a1" },
      "800": { "$value": "#075985" },
      "900": { "$value": "#0c4a6e" },
      "950": { "$value": "#082f49" }
    },
    "violet": {
      "50":  { "$value": "#f5f3ff" },
      "100": { "$value": "#ede9fe" },
      "200": { "$value": "#ddd6fe" },
      "300": { "$value": "#c4b5fd" },
      "400": { "$value": "#a78bfa" },
      "500": { "$value": "#8b5cf6" },
      "600": { "$value": "#7c3aed" },
      "700": { "$value": "#6d28d9" },
      "800": { "$value": "#5b21b6" },
      "900": { "$value": "#4c1d95" },
      "950": { "$value": "#2e1065" }
    }
  },
  "space": {
    "$type": "dimension",
    "0":  { "$value": "0px" },
    "1":  { "$value": "2px" },
    "2":  { "$value": "4px" },
    "3":  { "$value": "8px" },
    "4":  { "$value": "12px" },
    "5":  { "$value": "16px" },
    "6":  { "$value": "20px" },
    "8":  { "$value": "24px" },
    "10": { "$value": "32px" },
    "12": { "$value": "40px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "6px" },
    "lg":   { "$value": "10px" },
    "xl":   { "$value": "14px" },
    "2xl":  { "$value": "20px" },
    "full": { "$value": "9999px" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin":    { "$value": "1px" },
      "default": { "$value": "1px" },
      "thick":   { "$value": "2px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "0": { "$value": "none" },
    "1": { "$value": "0 1px 2px 0 rgb(15 23 42 / 0.06), 0 1px 3px 0 rgb(15 23 42 / 0.10)" },
    "2": { "$value": "0 2px 4px -1px rgb(15 23 42 / 0.06), 0 4px 12px -2px rgb(15 23 42 / 0.10)" },
    "3": { "$value": "0 4px 8px -2px rgb(15 23 42 / 0.08), 0 12px 24px -4px rgb(15 23 42 / 0.12)" },
    "4": { "$value": "0 8px 16px -4px rgb(15 23 42 / 0.10), 0 24px 48px -8px rgb(15 23 42 / 0.16)" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "'Inter var', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "$type": "dimension",
      "xs":   { "$value": "12px" },
      "sm":   { "$value": "13px" },
      "base": { "$value": "14px" },
      "lg":   { "$value": "16px" },
      "xl":   { "$value": "18px" },
      "2xl":  { "$value": "22px" },
      "3xl":  { "$value": "28px" },
      "4xl":  { "$value": "36px" },
      "5xl":  { "$value": "48px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold":     { "$value": "700" }
    },
    "line": {
      "height": {
        "$type": "number",
        "tight":   { "$value": "1.2" },
        "snug":    { "$value": "1.35" },
        "normal":  { "$value": "1.5" },
        "relaxed": { "$value": "1.7" }
      }
    },
    "tracking": {
      "$type": "dimension",
      "tight":  { "$value": "-0.02em" },
      "normal": { "$value": "0em" },
      "wide":   { "$value": "0.02em" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast":     { "$value": "120ms" },
      "normal":   { "$value": "200ms" },
      "slow":     { "$value": "320ms" },
      "slower":   { "$value": "480ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "cubic-bezier(0.2, 0, 0.2, 1)" },
      "entrance": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },
  "z": {
    "$type": "number",
    "base":    { "$value": "0" },
    "dropdown":{ "$value": "1000" },
    "sticky":  { "$value": "1100" },
    "overlay": { "$value": "1200" },
    "modal":   { "$value": "1300" },
    "toast":   { "$value": "1400" }
  },
  "size": {
    "control": {
      "$type": "dimension",
      "sm": { "$value": "28px" },
      "md": { "$value": "34px" },
      "lg": { "$value": "42px" }
    },
    "target": {
      "$type": "dimension",
      "min": { "$value": "24px" }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "480px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  }
}
